# ---------------------------------------------------------------------------
# Vibes Lite environment configuration
# Copy to .env and adjust. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------
VIBES_PROJECT_NAME=Vibes Lite
VIBES_CONFIG=config.yaml
VIBES_HOST=0.0.0.0
VIBES_PORT=8000

# Storage locations (relative paths resolve against the project root)
VIBES_RAW_DATA_DIR=data/raw
VIBES_PROCESSED_DATA_DIR=data/processed
VIBES_OUTPUTS_DIR=outputs

# Upload guard rails
VIBES_MAX_UPLOAD_MB=200

# Comma separated list of allowed browser origins, or * during development
VIBES_CORS_ORIGINS=*

# --- Frontend (Vite) ---------------------------------------------------------
# Empty value = use same-origin requests proxied by Vite to the backend.
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api and /outputs
# Local development: http://localhost:8000
# Docker Compose:    http://vibes-lite-backend:8000
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Optional future integrations (unused by the initial release) ------------
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=
# WEATHER_API_KEY=
