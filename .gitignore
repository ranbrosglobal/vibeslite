.dev/logs/

# --- Data & generated artifacts --------------------------------------------
# Keep the folders, ignore the payloads: real imagery is never committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# --- Notebooks / OS ---------------------------------------------------------
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*.swp

# --- Model dataset ----------------------------------------------------------
# 1.1 GB of training images: never commit the dataset itself.
image-dataset/
