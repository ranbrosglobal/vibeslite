# Frontend configuration (Vite). Copy to .env.local when overriding.
# Empty base URL = same-origin requests, proxied to the backend by Vite.
VITE_API_BASE_URL=

# Where Vite proxies /api and /outputs.
# Local development: http://localhost:8000
# Docker Compose:   http://vibes-lite-backend:8000
VITE_API_PROXY_TARGET=http://localhost:8000
