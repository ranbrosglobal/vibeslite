# Vercel Services builds every service from its own `root` directory, so the
# exclusions below must never hide a service's own sources. Keep the upload to
# what the builds actually need.
.venv/
**/node_modules/
.pytest_cache/
.freebuff/
.dev/
/notebooks/
/image-dataset/
/qa-evidence/
/data/
.DS_Store
*.log

# demo/ must stay in the upload: the web build copies demo/outputs into
# frontend/public/outputs so the deployed site can serve the analysis maps.
