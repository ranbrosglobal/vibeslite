# Vercel Services builds every service from its own `root` directory, so the
# exclusions below must never hide a service's own sources. Keep the upload to
# what the builds actually need.
.venv/
**/node_modules/
.pytest_cache/
.freebuff/
.dev/
notebooks/
image-dataset/
qa-evidence/
data/
.DS_Store
*.log

# The container API image copies outputs/ into the image (see Dockerfile), so it
# must stay in the upload. Everything else under outputs/ is generated locally.
